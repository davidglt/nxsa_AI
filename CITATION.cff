    given-names: "David"
    email: "davidglt@hotmail.com"
keywords:
  - XMM-Newton
  - EPIC-pn
  - HDBSCAN
  - clustering
  - x-ray astronomy
  - source detection
  - unsupervised learning
  - machine learning
  - python
